---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About - Justin Doone"
  description="16 years marketing high-trust products and complex B2B. Hong Kong, Toronto, and now Evolve ETFs."
>
  <!-- HERO (dark) -->
  <section class="dark-section relative pt-24 md:pt-36 pb-12 md:pb-16">
    <div class="relative z-10 mx-auto max-w-4xl px-6 lg:px-12">
      <img
        src="/images/profile-2026.jpg"
        alt="Justin Doone"
        width="200"
        height="200"
        class="hero-line w-36 h-36 md:w-44 md:h-44 rounded-full object-cover mb-10 ring-1 ring-on-dark-mute"
        data-line="0"
      />
      <p class="hero-line eyebrow mb-8" data-line="0">About</p>
      <h1
        class="hero-line heading-display text-5xl md:text-7xl mb-10 leading-[0.95] text-on-dark"
        data-line="1"
      >
        16 years marketing <em class="text-accent" style="font-style: italic;">high-trust products</em> and complex B2B.
      </h1>
      <p class="hero-line text-xl leading-relaxed mb-6 text-on-dark" data-line="2">
        Background mostly in financial services. Started in Hong Kong on the agency side of financial communications, then in-house IR, then marketing for a pan-Asian real estate developer. Moved to Toronto for real estate PE/AM at Greybrook and Clifton Blake. Now at Evolve ETFs, running digital marketing for a $9.7 billion ETF issuer.
      </p>
      <p class="hero-line text-lg leading-relaxed text-on-dark-soft" data-line="3">
        I write the copy, run the paid accounts, and build the tools the team plans against. That has been the job at every firm since 2016.
      </p>
    </div>
  </section>

  <!-- HOW I WORK (cream — breaks the dark stretch) -->
  <section class="light-section relative py-24 md:py-32" data-reveal>
    <div class="relative z-10 mx-auto max-w-4xl px-6 lg:px-12">
      <p class="eyebrow mb-8">How I work</p>
      <div class="space-y-8 leading-relaxed text-lg text-ink-soft">
        <p data-reveal data-reveal-delay="1">
          The work runs from copy through to analytics, and through compliance in the middle. I'll see a CTR dip in GA4 on a Monday and know it is the ad copy I shipped on Friday.
        </p>
        <p data-reveal data-reveal-delay="2">
          I build the team's tooling. Reporting consolidations, competitive-intel pipelines, automation for the recurring chores, ad-hoc diagnostics. AI assist puts that within reach in days. It used to need a quarter of engineering bandwidth.
        </p>
        <p data-reveal data-reveal-delay="3">
          Most of my work has been in regulated industries. I write copy with legal in mind from the first draft.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA (dark) -->
  <section class="dark-section relative py-24 md:py-32" data-reveal>
    <div class="relative z-10 mx-auto max-w-4xl px-6 lg:px-12">
      <p class="eyebrow mb-6">Get in touch</p>
      <h2 class="heading-display text-4xl md:text-5xl mb-8 text-on-dark">
        Tell me what you're trying to ship.
      </h2>
      <a
        href="mailto:justindoone@gmail.com"
        class="inline-flex items-center gap-2 bg-accent text-paper px-6 py-3 text-sm font-medium hover:bg-accent-warm transition-colors"
      >
        justindoone@gmail.com
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</BaseLayout>
