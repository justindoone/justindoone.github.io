---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkCard from '../components/WorkCard.astro';
import FeaturePanels from '../components/FeaturePanels.astro';

const all = (await getCollection('work')).filter((w) => !w.data.hidden);
const byOrder = (a, b) => a.data.order - b.data.order;

// The three that get full-bleed panels. Promote or demote a case by toggling
// `hero:` in its frontmatter — nothing here is hardcoded to a slug.
const heroes = all.filter((w) => w.data.hero).sort(byOrder).slice(0, 3);
const heroIds = new Set(heroes.map((h) => h.id));

// The list below the band deliberately excludes whatever is already in it.
// Repeating a case as a row directly under its own panel reads as padding,
// and a duplicate `transition:name` on one page breaks the shared-element
// morph outright.
const featured = all.filter((w) => w.data.featured && !heroIds.has(w.id)).sort(byOrder);
const showcase =
  featured.length > 0
    ? featured
    : all.filter((w) => !heroIds.has(w.id)).sort(byOrder).slice(0, 4);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Justin Doone',
  // Factual field, unlike the display copy above it — this should carry the
  // actual current title and is the one place to edit on a promotion.
  jobTitle: 'Digital Marketing Manager',
  worksFor: {
    '@type': 'Organization',
    name: 'Evolve ETFs',
  },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Toronto',
    addressRegion: 'ON',
    addressCountry: 'CA',
  },
  url: 'https://justindoone.github.io',
  sameAs: ['https://www.linkedin.com/in/jdoone'],
  email: 'mailto:justindoone@gmail.com',
};
---

<BaseLayout>
  <Fragment slot="head">
    <!-- Preload the LCP hero image (WebP first, with JPG fallback via image-set) -->
    <link rel="preload" as="image" type="image/webp" href="/images/hero-toronto.webp" />
  </Fragment>

  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(personSchema)}
  />

  <!-- Diagonal slash entrance overlay (first visit only — gated via .no-splash) -->
  <div class="slash-overlay slash-upper" aria-hidden="true"></div>
  <div class="slash-overlay slash-lower" aria-hidden="true"></div>

  <!-- HERO — full height so the scroll cue at its foot means something -->
  <section
    class="home-hero dark-section relative flex flex-col justify-center min-h-screen pt-32 md:pt-36 pb-32 md:pb-36"
  >
    <div class="hero-bg-image"></div>
    <div class="hero-bg-overlay"></div>

    <div class="relative z-10 mx-auto w-full max-w-7xl px-6 lg:px-12">
      <p class="hero-line eyebrow mb-8" data-line="0">Toronto. Marketing leadership.</p>
      <h1 class="hero-line heading-display text-5xl md:text-7xl lg:text-8xl max-w-5xl mb-10 text-on-dark" data-line="1">
        Marketing for <em class="text-accent" style="font-style: italic;">high-trust products</em> and complex B2B.
      </h1>
      <p class="hero-line text-lg md:text-xl max-w-3xl leading-relaxed mb-6 text-on-dark" data-line="2">
        Sixteen years of it, mostly in financial services. I've built a marketing function from scratch and led a team of eight. I write the copy, run the paid accounts, and build the tools the team plans against.
      </p>
      <p class="hero-line text-lg md:text-xl max-w-2xl leading-relaxed mb-12 text-on-dark-soft" data-line="3">
        Currently at Evolve ETFs, running digital marketing for a $9.7 billion issuer with more than forty funds. Greybrook Realty Partners, Clifton Blake Asset Management, and seven years at Eton Properties in Hong Kong before that.
      </p>
      <div class="hero-line flex flex-wrap gap-6 items-center" data-line="4">
        <a
          href="/work"
          class="inline-flex items-center gap-2 bg-accent text-paper px-6 py-3 text-sm font-medium hover:bg-accent-warm transition-colors"
        >
          See work
          <span aria-hidden="true">→</span>
        </a>
        <a
          href="mailto:justindoone@gmail.com"
          class="link-underline text-sm text-on-dark-soft hover:text-accent transition-colors"
        >
          justindoone@gmail.com
        </a>
      </div>
    </div>

    <div class="scroll-cue" aria-hidden="true"></div>
  </section>

  <!-- FRONT DOOR — three full-bleed panels -->
  <FeaturePanels entries={heroes} />

  <!-- SELECTED WORK (light) -->
  <section class="mx-auto max-w-7xl px-6 lg:px-12 pt-20 md:pt-28 pb-20">
    <div class="flex items-end justify-between mb-8" data-reveal>
      <div>
        <p class="eyebrow mb-3">Recent work</p>
        <h2 class="heading-display text-4xl md:text-5xl text-ink">
          Case studies
        </h2>
      </div>
      <a
        href="/work"
        class="hidden md:inline-block text-sm text-ink-soft link-underline hover:text-accent transition-colors"
      >
        View all →
      </a>
    </div>

    <div>
      {
        showcase.map((entry, i) => (
          <div data-reveal data-reveal-delay={Math.min(i + 1, 4)}>
            <WorkCard
              title={entry.data.title}
              client={entry.data.client}
              role={entry.data.role}
              date={entry.data.date}
              summary={entry.data.summary}
              href={`/work/${entry.id}`}
              tags={entry.data.tags}
              accent={entry.data.accent}
              accentSecondary={entry.data.accentSecondary}
              cover={entry.data.cover}
              cardCover={entry.data.cardCover}
              id={entry.id}
              index={i}
            />
          </div>
        ))
      }
      <div class="border-t border-rule"></div>
    </div>

    <div class="mt-12 md:hidden">
      <a
        href="/work"
        class="text-sm text-ink-soft link-underline hover:text-accent transition-colors"
      >
        View all work →
      </a>
    </div>
  </section>

  <!-- CTA (dark) -->
  <section class="dark-section relative py-24 md:py-32" data-reveal>
    <div class="relative z-10 mx-auto max-w-7xl px-6 lg:px-12">
      <p class="eyebrow mb-6">Currently</p>
      <p class="heading-display text-3xl md:text-5xl max-w-4xl leading-tight text-on-dark">
        Open to consulting and in-house roles.
      </p>
      <a
        href="mailto:justindoone@gmail.com"
        class="inline-flex items-center gap-2 mt-10 bg-accent text-paper px-6 py-3 text-sm font-medium hover:bg-accent-warm transition-colors"
      >
        Start a conversation
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</BaseLayout>
